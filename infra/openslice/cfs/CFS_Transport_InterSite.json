    {"name": "connectivity_type", "valueType": "TEXT", "configurable": true,
     "serviceSpecCharacteristicValue": [{"value": {"value": "point-to-point"}, "isDefault": true, "valueType": "TEXT"}]},
    {"name": "latencyOneWayMsP99", "description": "Latence aller simple SDP-a-SDP <= 20 ms (P99)", "valueType": "INTEGER", "configurable": true,
     "serviceSpecCharacteristicValue": [{"value": {"value": "20"}, "isDefault": true, "valueType": "INTEGER"}]},
    {"name": "jitterMs", "valueType": "INTEGER", "configurable": true,
     "serviceSpecCharacteristicValue": [{"value": {"value": "2"}, "isDefault": true, "valueType": "INTEGER"}]},
    {"name": "guaranteedBandwidthMbps", "valueType": "INTEGER", "configurable": true,
     "serviceSpecCharacteristicValue": [{"value": {"value": "1000"}, "isDefault": true, "valueType": "INTEGER"}]},
    {"name": "restorationMs", "valueType": "INTEGER", "configurable": true,
