#!/usr/bin/env bash
# Copier en env.sh et adapter a votre banc.

# NBI des trois OSM
export OSM1=osm1.example.lan        # domaine RAN (d1)
export OSM2=osm2.example.lan        # domaine edge/MEC (d2)
export OSM3=osm3.example.lan        # domaine coeur (d3)

export OSM_USER=admin
export OSM_PASSWORD=admin
export OSM_PROJECT=admin

# Comptes VIM enregistres dans chaque OSM (osm vim-list)
export VIM1=VIM1
export VIM2=VIM2
export VIM3=VIM3

# Cluster K8s Sylva (option KNF coeur) enregistre dans osm3
export K8S_CLUSTER_CORE=wc-5g-core2
